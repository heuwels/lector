# Pinned on-device dictionary releases — single source of truth.
# Sourced by the Dockerfile (dict stage), the CI workflows, and the running
# app (api/src/lib/dict-pins.ts). Per language:
#   DICT_VERSION_<LANG>  release tag holding dictionary-<lang>.db
#   DICT_SHA256_<LANG>   sha256 of that asset
# DICT_LANGS lists every published language. The image bakes none of them
# by default: the app downloads what a box asks for and checks it against
# the sha256 here (#438).
# Regenerate a language with: scripts/release-dict.sh <lang>
DICT_LANGS="af de es fr it nl pt eo ru grc tr uk pl cs zh ja ko id sv la ar hi"

# af
DICT_VERSION_AF=dict-af-2026-06-19
DICT_SHA256_AF=d8620401a3696f0f547b9c8af5a507b3c83d9d0971af35db79a9e4e9491854cb

# de
