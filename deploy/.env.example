# Lector Configuration
# Copy to .env and adjust as needed

# Image version. Pin a version, or use 'latest'.
# A pinned version carries no 'v' prefix. Write 3.10.0, not v3.10.0. The git tag
# on GitHub keeps the prefix, and the image tag drops it.
LECTOR_VERSION=latest

# Deployment mode: "selfhost" (default) or "cloud". Leave as-is for a
# self-hosted instance. "cloud" is the future managed offering and refuses to
# boot until accounts/auth ship (heuwels/lector#218; seam tracked in #242) —
# except behind a declared authenticating gateway (LECTOR_CLOUD_GATE=external,
# the canary shape; see deploy/cloud/).
LECTOR_MODE=selfhost

# Host port for the web interface
WEB_PORT=3400

# Browser-facing API origin. The web app (in the user's browser) calls the Hono
# API directly, so set this to the URL the browser uses to reach it: your host
# plus the API's published port (3457) — e.g. http://lector.my-host:3457. Must be
# reachable FROM THE BROWSER, not an internal Docker name. Injected into
# /__env.js at container start. Unset → falls back to http://localhost:3457
# (only correct when browsing from the Docker host itself).
API_URL=http://localhost:3457

# Persistent data location
DATA_PATH=./data

# On-device dictionaries. The image ships none of them. Lector downloads the
# dictionary for a language when you add that language in the picker, and keeps
# it in the `lector-dict` volume. The download runs in the background, and the
# language works at once because a word with no entry yet goes to the AI lookup.
#
# Name languages here to pre-fetch them at boot instead. Use `all` for every
# published language. Leave it empty to download only what you add.
DICT_LANGS=

# Set to 0 to never download a dictionary. Pair it with the `:full` image tag,
# which bakes every dictionary, for an install with no internet.
DICT_FETCH=

# Where the dictionaries live inside the container. The default is the
# `lector-dict` volume, which keeps ~2.6 GB of re-downloadable data out of your
# DATA_PATH backups. Set /app/data/dict to keep one directory for everything.
DICT_DIR=/app/dict

# LLM provider for translations: "anthropic" (cloud) or "openai" (OpenAI-compatible
# local/self-hosted server — the bundled Ollama service, LM Studio, vLLM, …)
LLM_PROVIDER=anthropic

# Model served by the OpenAI-compatible backend (used when LLM_PROVIDER=openai)
OPENAI_COMPAT_MODEL=llama3.1:8b

# Anthropic API key (only needed when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# Claude OAuth token (Pro/Team plan credits — preferred over API key)
# Obtain via: claude setup-token
CLAUDE_OAUTH_TOKEN=

# Error tracking + tracing (optional, opt-in). Set SENTRY_DSN to your own
# Sentry.io, self-hosted Sentry, or GlitchTip project — one DSN covers the API
# and, via /__env.js, the browser. Unset → Sentry stays completely off.
# (NEXT_PUBLIC_SENTRY_DSN only matters when building your own image; on the
# prebuilt image the DSN is injected at runtime, so set just SENTRY_DSN.)
SENTRY_DSN=
# Trace sampling rate 0–1 (server/API). 0 = errors only, no traces. Default 1.0.
# SENTRY_TRACES_SAMPLE_RATE=
